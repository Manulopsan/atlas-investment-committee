# ATLAS Investment Committee — environment template.
# Copy to .env.local and fill in. Never commit .env.local.

# By default the agents run on your Claude SUBSCRIPTION through the Claude Code
# CLI (Settings → Proveedor de IA). Install it and sign in once:
#   npm install -g @anthropic-ai/claude-code && claude auth login
# No API key is needed for that mode (and the app strips it from Claude Code's
# environment so it never bills the API).
#
# Optional: Anthropic API key, only for the "API de Anthropic" provider (pay per token).
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact e-mail
# (https://www.sec.gov/os/accessing-edgar-data). Example: "Atlas Research you@example.com"
SEC_USER_AGENT=

# Optional free-tier price provider (https://www.alphavantage.co/support/#api-key).
# If empty, the Stooq public delayed quote is used.
ALPHAVANTAGE_API_KEY=

# Optional: SQLite file location (default ./data/atlas.db)
ATLAS_DB_PATH=

# Session runner: "inprocess" (default, the web server runs sessions) or "worker"
# (the web server only enqueues; run `npm run worker` in a second terminal).
ATLAS_RUNNER=inprocess
# Sessions the worker may run in parallel.
ATLAS_WORKER_CONCURRENCY=1

# Optional HTTP Basic auth if you expose the app beyond localhost, format user:password
ATLAS_BASIC_AUTH=
